.env
*.env
!.env.example
!example.env

# ==========================================
# 2. Dữ liệu local & SQLite Database
# ==========================================
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Thư mục lưu file export Excel/báo cáo tạm
exports/*.xlsx
exports/*.csv
*.xlsx
*.csv

